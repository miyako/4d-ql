var $root : 4D.Folder:=Folder(Get 4D folder(Database folder); fk platform path)
var $report : Object:=New object("version"; Application version(*); "cases"; New collection())
var $doc; $body; $pictureObject; $box; $item; $other; $break : Object
var $picture : Picture
var $kind; $stage : Text
For each ($kind; New collection("paper"; "section"; "jpeg"))
	READ PICTURE FILE($root.file("Resources/checker.png").platformPath; $picture)
	If ($kind="jpeg")
		CONVERT PICTURE($picture; ".jpg"; 0.8)
	End if
	$doc:=WP New()
	$body:=WP Get body($doc)
	WP SET TEXT($body; "BODY 😀 ONE"; wk replace)
	WP INSERT FORMULA($body; Formula("BODYCACHE"); wk append)
	$break:=WP Insert break($body; wk section break; wk append)
	WP SET TEXT($body; "BODY TWO"; wk append)
	WP NEW BOOKMARK(WP Text range($body; 1; 5); "object_body")
	$other:=WP Add picture($doc; $picture)
	$other:=WP New text box($doc; 1)
	WP SET TEXT($other; "KEEP 😀"; wk replace)
	WP INSERT FORMULA($other; Formula("KEEPCACHE"); wk append)
	$other:=WP New header(WP Get section($doc; 1))
	WP SET TEXT($other; "KEEP HEADER"; wk replace)
	$item:=New object("name"; $kind; "stages"; New collection())
	For each ($stage; New collection("original"; "picture"; "box"; "target"; "align"; "alignStart"; "offset"; "layout"; "layoutSwap"; "front"; "repeat"; "removePicture"; "removeBox"; "recreate"))
		Case of
			: ($stage="picture")
				$pictureObject:=WP Add picture($doc; $picture)
				WP SET ATTRIBUTES($pictureObject; wk anchor page; 1; wk width; "48pt"; wk height; "32pt"; wk anchor horizontal offset; "0pt"; wk anchor vertical offset; "0pt"; wk anchor layout; wk in front of text)
			: ($stage="box")
				$box:=WP New text box($doc; 1)
				WP SET TEXT($box; "NEW BOX 😀 日é"; wk replace)
				WP SET ATTRIBUTES($box; wk width; "180pt"; wk height; "90pt"; wk anchor horizontal offset; "0pt"; wk anchor vertical offset; "0pt")
			: ($stage="target")
				If ($kind="section")
					WP SET ATTRIBUTES($pictureObject; wk anchor section; 2; wk anchor page; wk anchor all)
					WP SET ATTRIBUTES($box; wk anchor section; 2; wk anchor page; wk anchor all)
				Else
					WP SET ATTRIBUTES($pictureObject; wk anchor section; wk anchor all; wk anchor page; 2)
					WP SET ATTRIBUTES($box; wk anchor section; wk anchor all; wk anchor page; 2)
				End if
			: ($stage="align")
				WP SET ATTRIBUTES($pictureObject; wk anchor horizontal align; wk right; wk anchor vertical align; wk bottom)
				WP SET ATTRIBUTES($box; wk anchor horizontal align; wk center; wk anchor vertical align; wk center)
			: ($stage="alignStart")
				WP SET ATTRIBUTES($pictureObject; wk anchor horizontal align; wk left; wk anchor vertical align; wk top)
				WP SET ATTRIBUTES($box; wk anchor horizontal align; wk left; wk anchor vertical align; wk top)
			: ($stage="offset")
				WP SET ATTRIBUTES($pictureObject; wk anchor horizontal align; 0; wk anchor vertical align; 0; wk anchor horizontal offset; "12pt"; wk anchor vertical offset; "24pt")
				WP SET ATTRIBUTES($box; wk anchor horizontal align; 0; wk anchor vertical align; 0; wk anchor horizontal offset; "30pt"; wk anchor vertical offset; "40pt")
			: ($stage="layout")
				WP SET ATTRIBUTES($pictureObject; wk anchor layout; wk behind text)
				WP SET ATTRIBUTES($box; wk anchor layout; wk text wrap square)
			: ($stage="layoutSwap")
				WP SET ATTRIBUTES($pictureObject; wk anchor layout; wk text wrap square)
				WP SET ATTRIBUTES($box; wk anchor layout; wk behind text)
			: ($stage="front")
				WP SET ATTRIBUTES($pictureObject; wk anchor layout; wk in front of text)
				WP SET ATTRIBUTES($box; wk anchor layout; wk in front of text)
			: ($stage="repeat")
				WP SET ATTRIBUTES($pictureObject; wk anchor section; wk anchor all; wk anchor page; wk anchor all)
				WP SET ATTRIBUTES($box; wk anchor section; wk anchor all; wk anchor page; wk anchor all)
			: ($stage="removePicture")
				WP DELETE PICTURE($pictureObject)
			: ($stage="removeBox")
				WP DELETE TEXT BOX($box)
			: ($stage="recreate")
				$pictureObject:=WP Add picture($doc; $picture)
				$box:=WP New text box($doc; 1)
		End case
		WP EXPORT DOCUMENT($doc; $root.file("Output/object-"+$kind+"-"+$stage+".4wp").platformPath; wk 4wp)
		$item.stages.push(New object("name"; $stage; "stats"; wp_media_stats($doc)))
	End for each
	$report.cases.push($item)
End for each
$root.file("Output/object-report.json").setText(JSON Stringify($report; *))
