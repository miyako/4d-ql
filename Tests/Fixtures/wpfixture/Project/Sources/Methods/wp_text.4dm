// Character and paragraph formatting, style sheets, lists, tabs and links.
var $doc : Object:=WP New()
var $body : Object:=WP Get body($doc)
var $r : Object
WP SET ATTRIBUTES($doc; wk title; "Text formatting probe"; wk author; "4D Quick Look"; wk subject; "Probe subject"; wk company; "Probe Co."; wk notes; "Probe notes")

var $title : Object:=WP New style sheet($doc; wk type paragraph; "Title 1")
WP SET ATTRIBUTES($title; wk font family; "Helvetica"; wk font size; "24pt"; wk font bold; wk true; wk text color; "#1F4E79"; wk margin bottom; "12pt")
var $quote : Object:=WP New style sheet($doc; wk type paragraph; "Quote")
WP SET ATTRIBUTES($quote; wk font italic; wk true; wk margin left; "1cm"; wk border style left; wk solid; wk border width left; "3pt"; wk border color left; "#999999"; wk padding left; "6pt")
var $mark : Object:=WP New style sheet($doc; wk type character; "Marker")
WP SET ATTRIBUTES($mark; wk background color; "#FFFF00"; wk font bold; wk true)

$r:=WP Text range($body; wk start text; wk end text)
WP SET TEXT($r; "Document title"; wk replace)
WP SET ATTRIBUTES(WP Paragraph range($r); wk style sheet; "Title 1")

$r:=WP Insert break($body; wk paragraph break; wk append; wk include in range)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Bold"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk font bold; wk true)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " italic"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk font bold; wk false; wk font italic; wk true)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " underline"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk font italic; wk false; wk text underline style; wk dotted; wk text underline color; "#FF0000")
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " strike"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk text underline style; wk none; wk text linethrough style; wk double; wk text linethrough color; "#0000FF")
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " red"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk text linethrough style; wk none; wk text color; "#CC0000"; wk background color; "#EEEEEE")
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " Courier 9pt"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk text color; "#000000"; wk background color; wk transparent; wk font family; "Courier"; wk font size; "9pt")
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " super"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk font family; "Times New Roman"; wk font size; "12pt"; wk vertical align; wk superscript)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " sub"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk vertical align; wk subscript)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " small caps"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk vertical align; wk baseline; wk text transform; wk small uppercase)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " shadow"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk text transform; wk none; wk text shadow color; "#808080"; wk text shadow offset; 2)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " plain"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk text shadow color; wk none)

var $align : Collection:=[wk left; wk center; wk right; wk justify]
var $names : Collection:=["Left aligned"; "Centered"; "Right aligned"; "Justified paragraph text that is long enough to wrap across more than one line so that justification is visible in the rendering of the page."]
var $i : Integer
For ($i; 0; 3)
	$r:=WP Insert break($body; wk paragraph break; wk append)
	$r:=WP Text range($body; wk end text; wk end text)
	WP SET TEXT($r; $names[$i]; wk append; wk include in range)
	WP SET ATTRIBUTES($r; wk style sheet; "Normal"; wk font size; "12pt")
	WP SET ATTRIBUTES(WP Paragraph range($r); wk text align; $align[$i])
End for

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Indented paragraph with first line indent, spacing, line height, border, padding and background."; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk text align; wk left; wk margin left; "2cm"; wk margin right; "1cm"; wk text indent; "1cm"; wk margin top; "6pt"; wk margin bottom; "6pt"; wk line height; "150%"; wk border style; wk solid; wk border width; "1pt"; wk border color; "#336699"; wk border radius; "4pt"; wk padding; "4pt"; wk background color; "#EEF4FA")

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "A quotation in a paragraph style sheet."; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk margin left; 0; wk margin right; 0; wk text indent; 0; wk margin top; 0; wk margin bottom; 0; wk line height; wk normal; wk border style; wk none; wk padding; 0; wk border radius; 0; wk background color; wk transparent; wk style sheet; "Quote")

var $types : Collection:=[wk disc; wk circle; wk square; wk decimal; wk lower roman; wk upper latin; wk hollow square; wk diamond]
For ($i; 0; $types.length-1)
	$r:=WP Insert break($body; wk paragraph break; wk append)
	$r:=WP Text range($body; wk end text; wk end text)
	WP SET TEXT($r; "List item "+String($i+1); wk append; wk include in range)
	WP SET ATTRIBUTES(WP Paragraph range($r); wk style sheet; "Normal"; wk list style type; $types[$i])
End for
$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Custom numbered A"; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk list style type; wk decimal; wk list string format ltr; "(#)"; wk list start number; 7)
$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Custom numbered B"; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk list style type; wk decimal; wk list string format ltr; "(#)")

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Name\tPrice\tQty"; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk list style type; wk none; wk tab stop offsets; New collection("5cm"; "9cm"); wk tab stop types; New collection(wk right; wk center); wk tab stop leadings; New collection("."; ""))

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "First line"; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk tab stop offsets; New collection(); wk tab stop types; New collection(); wk tab stop leadings; New collection())
$r:=WP Insert break($body; wk line break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "second line after a line break"; wk append; wk include in range)

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Visit 4D"; wk append; wk include in range)
WP SET LINK($r; New object("url"; "https://www.4d.com"))
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; " / method link"; wk append; wk include in range)
WP SET LINK($r; New object("method"; "wp_value"))

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Right-to-left اللغة العربية and 日本語テキスト"; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk direction; wk right to left)

$r:=WP Insert break($body; wk paragraph break; wk append)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "Character style sheet: "; wk append; wk include in range)
WP SET ATTRIBUTES(WP Paragraph range($r); wk direction; wk left to right)
$r:=WP Text range($body; wk end text; wk end text)
WP SET TEXT($r; "marked"; wk append; wk include in range)
WP SET ATTRIBUTES($r; wk style sheet; "Marker")

wp_save($doc; "text")
