// Tables: header rows, borders, widths, merged cells, alignment and a datasource template.
var $doc : Object:=WP New()
var $body : Object:=WP Get body($doc)
var $r : Object
WP SET ATTRIBUTES($doc; wk title; "Table probe")
WP SET TEXT($body; "Invoice lines"; wk append)
$r:=WP Insert break($body; wk paragraph break; wk append)

var $table : Object:=WP Insert table(WP Text range($body; wk end text; wk end text); wk append; wk include in range)
$r:=WP Table append row($table; "Item"; "Qty"; "Price")
$r:=WP Table append row($table; "Widget"; 2; 9.5)
$r:=WP Table append row($table; "Gadget with a longer description that wraps"; 10; 120)
$r:=WP Table append row($table; "Total"; ""; 1219)
WP SET ATTRIBUTES($table; wk header row count; 1; wk table align; wk center; wk border style; wk solid; wk border width; "1pt"; wk border color; "#404040")
var $header : Object:=WP Table get rows($table; 1)
WP SET ATTRIBUTES($header; wk background color; "#1F4E79"; wk text color; "#FFFFFF"; wk font bold; wk true)
var $col : Object:=WP Table get columns($table; 1)
WP SET ATTRIBUTES($col; wk width; "200pt")
var $nums : Object:=WP Table get columns($table; 2; 2)
WP SET ATTRIBUTES($nums; wk text align; wk right; wk width; "80pt")
var $merge : Object:=WP Table get cells($table; 1; 4; 2; 1)
WP TABLE MERGE CELLS($merge)
WP SET ATTRIBUTES(WP Table get cells($table; 1; 4; 1; 1); wk font italic; wk true; wk background color; "#DDEBF7")
WP SET ATTRIBUTES(WP Table get cells($table; 3; 2; 1; 2); wk vertical align; wk middle; wk padding; "4pt")

$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "Datasource table"; wk append)
$r:=WP Insert break($body; wk paragraph break; wk append)
var $ds : Object:=WP Insert table(WP Text range($body; wk end text; wk end text); wk append; wk include in range)
$r:=WP Table append row($ds; "Name"; "Amount")
$r:=WP Table append row($ds; Formula(This.item.name); Formula(This.item.amount))
WP SET ATTRIBUTES($ds; wk header row count; 1; wk datasource; Formula(This.data.lines); wk border style; wk dotted; wk border width; "0.5pt"; wk table align; wk left)
var $rows : Object:=WP Table get rows($ds; 1)
WP SET ATTRIBUTES($rows; wk font bold; wk true; wk border style bottom; wk double; wk border width bottom; "3pt")
$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "After the tables."; wk append)
wp_save($doc; "table")
