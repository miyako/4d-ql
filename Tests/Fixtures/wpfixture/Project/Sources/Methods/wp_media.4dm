// Larger pictures, JPEG, picture URLs, picture formulas and method links.
ARRAY TEXT($allowed; 1)
$allowed{1}:="wp_*"
SET ALLOWED METHODS($allowed)
var $doc : Object:=WP New()
var $body : Object:=WP Get body($doc)
var $r : Object
var $picture; $jpeg; $big : Picture
READ PICTURE FILE(Get 4D folder(Database folder)+"Resources"+Folder separator+"checker.png"; $picture)
$jpeg:=$picture
CONVERT PICTURE($jpeg; ".jpg"; 0.8)
TRANSFORM PICTURE($picture; Scale; 20; 20)
$big:=$picture
CONVERT PICTURE($big; ".png")
WP SET ATTRIBUTES($doc; wk title; "Media probe")
WP SET TEXT($body; "JPEG: "; wk append)
WP INSERT PICTURE(WP Text range($body; wk end text; wk end text); $jpeg; wk append)
WP SET TEXT(WP Text range($body; wk end text; wk end text); " big: "; wk append)
WP INSERT PICTURE(WP Text range($body; wk end text; wk end text); $big; wk append)
var $images : Collection:=WP Get elements($body; wk type image)
WP SET ATTRIBUTES($images[1]; wk width; "120pt"; wk height; "80pt"; wk image display mode; wk proportional centered)
$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "Formula picture: "; wk append)
WP INSERT PICTURE(WP Text range($body; wk end text; wk end text); $jpeg; wk append)
$images:=WP Get elements($body; wk type image)
WP SET ATTRIBUTES($images[2]; wk image formula; Formula(This.data.logo))
$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "URL picture: "; wk append)
WP INSERT PICTURE(WP Text range($body; wk end text; wk end text); $jpeg; wk append)
$images:=WP Get elements($body; wk type image)
WP SET ATTRIBUTES($images[3]; wk image url; "https://example.com/logo.png")
$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "Method link"; wk append)
$r:=WP Paragraph range(WP Text range($body; wk end text; wk end text))
WP SET LINK($r; New object("method"; "wp_value"))
$r:=WP Insert break($body; wk paragraph break; wk append)
WP SET TEXT($body; "Bookmark link"; wk append)
WP NEW BOOKMARK(WP Text range($body; 1; 5); "start")
$r:=WP Paragraph range(WP Text range($body; wk end text; wk end text))
WP SET LINK($r; New object("bookmark"; "start"))
wp_save($doc; "media")
