var $root : 4D.Folder:=Folder(Get 4D folder(Database folder); fk platform path)
var $report : Object:=New object("version"; Application version(*); "offsets"; New collection(); "mutations"; New collection(); "splices"; New collection(); "operations"; New collection())
var $doc; $body; $range; $item : Object
var $kind; $replacement : Text
var $start; $end; $i : Integer
var $picture : Picture
READ PICTURE FILE($root.file("Resources/checker.png").platformPath; $picture)
For each ($kind; New collection("unicode"; "paragraphs"; "break"; "picture"; "empty"; "singleEmpty"; "lists"; "styles"))
	$doc:=WP New()
	$body:=WP Get body($doc)
	Case of
		: ($kind="unicode")
			WP SET TEXT($body; "A😀日éB"; wk replace)
		: ($kind="paragraphs")
			WP SET TEXT($body; "AB"; wk replace)
			$range:=WP Insert break($body; wk paragraph break; wk append)
			WP SET TEXT($body; "CD"; wk append)
		: ($kind="break")
			WP SET TEXT($body; "AB"; wk replace)
			$range:=WP Insert break($body; wk line break; wk append)
			WP SET TEXT($body; "CD"; wk append)
		: ($kind="picture")
			WP SET TEXT($body; "AB"; wk replace)
			WP INSERT PICTURE($body; $picture; wk append)
			WP SET TEXT($body; "CD"; wk append)
		: ($kind="empty")
			$range:=WP Insert break($body; wk paragraph break; wk append)
		: ($kind="lists")
			WP SET TEXT($body; "AB"+Char(13)+"CD"; wk replace)
			WP SET ATTRIBUTES($body; wk list style type; wk disc)
		: ($kind="styles")
			WP SET TEXT($body; "ABCD"; wk replace)
			WP SET ATTRIBUTES(WP Text range($body; 2; 4); wk font bold; wk true)
	End case
	WP NEW BOOKMARK(WP Text range($body; 1; 2); "first")
	WP NEW BOOKMARK(WP Text range($body; 2; 2); "collapsed")
	WP NEW BOOKMARK(WP Text range($body; wk start text; wk end text); "whole")
	$item:=wp_range_stats($doc)
	$item.name:=$kind
	$report.offsets.push($item)
	WP EXPORT DOCUMENT($doc; $root.file("Output/range-"+$kind+".4wp").platformPath; wk 4wp)
End for each
For each ($kind; New collection("split"; "lineBreak"; "pictureInsert"; "richPaste"; "join"; "pictureDelete"; "pictureMove"; "appendParagraph"; "format"; "emptyTyping"))
	$doc:=WP New()
	$body:=WP Get body($doc)
	WP SET TEXT($body; "abcdefghi"; wk replace)
	If ($kind="emptyTyping")
		WP SET TEXT($body; ""; wk replace)
	End if
	If ($kind="join")
		$range:=WP Insert break(WP Text range($body; 4; 4); wk paragraph break; wk replace)
	End if
	If (($kind="pictureDelete") | ($kind="pictureMove"))
		WP INSERT PICTURE(WP Text range($body; 4; 4); $picture; wk replace)
	End if
	WP NEW BOOKMARK(WP Text range($body; 3; 6); "span")
	WP NEW BOOKMARK(WP Text range($body; 4; 4); "point")
	WP NEW BOOKMARK(WP Text range($body; wk start text; wk end text); "all")
	$item:=New object("name"; $kind; "before"; wp_range_stats($doc))
	WP EXPORT DOCUMENT($doc; $root.file("Output/range-edit-"+$kind+"-original.4wp").platformPath; wk 4wp)
	Case of
		: ($kind="split")
			$range:=WP Insert break(WP Text range($body; 4; 4); wk paragraph break; wk replace)
		: ($kind="lineBreak")
			$range:=WP Insert break(WP Text range($body; 4; 4); wk line break; wk replace)
		: ($kind="pictureInsert")
			WP INSERT PICTURE(WP Text range($body; 4; 4); $picture; wk replace)
		: ($kind="richPaste")
			WP SET TEXT(WP Text range($body; 4; 4); "XY"+Char(13)+"Z"; wk replace)
		: ($kind="join")
			WP SET TEXT(WP Text range($body; 4; 5); ""; wk replace)
		: (($kind="pictureDelete") | ($kind="pictureMove"))
			WP SET TEXT(WP Text range($body; 4; 5); ""; wk replace)
			If ($kind="pictureMove")
				WP INSERT PICTURE(WP Text range($body; 7; 7); $picture; wk replace)
			End if
		: ($kind="appendParagraph")
			$range:=WP Insert break($body; wk paragraph break; wk append)
		: ($kind="format")
			WP SET ATTRIBUTES(WP Text range($body; 2; 8); wk font bold; wk true)
		: ($kind="emptyTyping")
			WP SET TEXT(WP Text range($body; 1; 1); "😀日"; wk replace)
	End case
	$item.after:=wp_range_stats($doc)
	$report.operations.push($item)
	WP EXPORT DOCUMENT($doc; $root.file("Output/range-edit-"+$kind+"-native.4wp").platformPath; wk 4wp)
End for each
// Shared native starting archive for the exhaustive text-splice cases.
$doc:=WP New()
$body:=WP Get body($doc)
WP SET TEXT($body; "abcdefghi"; wk replace)
WP NEW BOOKMARK(WP Text range($body; 3; 6); "span")
WP NEW BOOKMARK(WP Text range($body; 4; 4); "point")
WP NEW BOOKMARK(WP Text range($body; 1; 10); "all")
WP NEW BOOKMARK(WP Text range($body; 1; 1); "leading")
WP NEW BOOKMARK(WP Text range($body; 10; 10); "trailing")
$report.baseline:=wp_range_stats($doc)
WP EXPORT DOCUMENT($doc; $root.file("Output/range-editing.4wp").platformPath; wk 4wp)
For each ($kind; New collection("placeholder"; "literalZeroWidth"; "nestedList"))
	Case of
		: ($kind="placeholder")
			$doc:=WP New("<html><body><p><span>"+Char(8203)+"</span></p><p>CD</p></body></html>")
		: ($kind="literalZeroWidth")
			$doc:=WP New("<html><body><p>A"+Char(8203)+"B</p></body></html>")
		: ($kind="nestedList")
			$doc:=WP New("<html><body><ul><li>AB<ul><li>CD</li></ul></li><li>EF</li></ul></body></html>")
	End case
	WP NEW BOOKMARK(WP Text range(WP Get body($doc); wk start text; wk end text); "whole")
	$item:=wp_range_stats($doc)
	$item.name:=$kind
	$report.offsets.push($item)
	WP EXPORT DOCUMENT($doc; $root.file("Output/range-"+$kind+".4wp").platformPath; wk 4wp)
End for each
For ($start; 1; 10)
	For ($end; $start; 10)
		For each ($replacement; New collection(""; "XY"; "😀日"))
			$doc:=WP New()
			$body:=WP Get body($doc)
			WP SET TEXT($body; "abcdefghi"; wk replace)
			WP NEW BOOKMARK(WP Text range($body; 3; 6); "span")
			WP NEW BOOKMARK(WP Text range($body; 4; 4); "point")
			WP NEW BOOKMARK(WP Text range($body; 1; 10); "all")
			WP NEW BOOKMARK(WP Text range($body; 1; 1); "leading")
			WP NEW BOOKMARK(WP Text range($body; 10; 10); "trailing")
			WP SET TEXT(WP Text range($body; $start; $end); $replacement; wk replace)
			$item:=wp_range_stats($doc)
			$item.edit:=New object("start"; $start; "end"; $end; "text"; $replacement)
			$report.mutations.push($item)
			$doc:=WP New()
			$body:=WP Get body($doc)
			WP SET TEXT($body; "abcdefghi"; wk replace)
			WP NEW BOOKMARK(WP Text range($body; 3; 6); "span")
			WP NEW BOOKMARK(WP Text range($body; 4; 4); "point")
			WP NEW BOOKMARK(WP Text range($body; 1; 10); "all")
			WP NEW BOOKMARK(WP Text range($body; 1; 1); "leading")
			WP NEW BOOKMARK(WP Text range($body; 10; 10); "trailing")
			WP SET TEXT(WP Text range($body; $start; $end); ""; wk replace)
			WP SET TEXT(WP Text range($body; $start; $start); $replacement; wk replace)
			$item:=wp_range_stats($doc)
			$item.edit:=New object("start"; $start; "end"; $end; "text"; $replacement)
			$report.splices.push($item)
		End for each
	End for
End for
$report.structures:=wp_structure_probe
$report.management:=wp_bookmark_probe
$root.file("Output/range-report.json").setText(JSON Stringify($report; *))
