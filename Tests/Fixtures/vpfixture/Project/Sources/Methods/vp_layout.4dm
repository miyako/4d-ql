#DECLARE($area : Text)
VP SET SHEET NAME($area; "Data"; 0)
VP SET ROW COUNT($area; 24; 0)
VP SET COLUMN COUNT($area; 12; 0)
VP SET DEFAULT STYLE($area; {font: "11pt Arial"; foreColor: "#202020"; backColor: "#ffffff"; vAlign: 1}; 0)
VP ADD STYLESHEET($area; "SharedHeading"; {font: "bold 16pt Arial"; backColor: "#1f4e79"; foreColor: "#ffffff"; hAlign: 1}; vk workbook)
VP ADD STYLESHEET($area; "LocalMoney"; {formatter: "$#,##0.00"; foreColor: "#006600"}; 0)
VP SET CELL STYLE(VP Cell($area; 0; 4; 0); {name: "SharedHeading"})
VP SET TEXT VALUE(VP Cell($area; 0; 4; 0); "Merged heading")
VP ADD SPAN(VP Cells($area; 0; 4; 4; 2; 0))
VP SET NUM VALUE(VP Cell($area; 1; 7; 0); 42.5)
VP SET CELL STYLE(VP Cell($area; 1; 7; 0); {name: "LocalMoney"})
VP SET CELL STYLE(VP Row($area; 7; 1; 0); {backColor: "#fff2cc"; font: "italic 12pt Arial"})
VP SET CELL STYLE(VP Column($area; 1; 1; 0); {foreColor: "#7030a0"; hAlign: 2})
VP SET ROW ATTRIBUTES(VP Row($area; 4; 1; 0); {height: 32})
VP SET ROW ATTRIBUTES(VP Row($area; 9; 1; 0); {height: 27; visible: False})
VP SET COLUMN ATTRIBUTES(VP Column($area; 0; 1; 0); {width: 180})
VP SET COLUMN ATTRIBUTES(VP Column($area; 2; 1; 0); {width: 90; visible: False})
VP SET TEXT VALUE(VP Cell($area; 0; 10; 0); "Wrapped and underlined")
VP SET CELL STYLE(VP Cell($area; 0; 10; 0); {font: "italic bold 13pt Arial"; hAlign: 2; vAlign: 2; wordWrap: True; textDecoration: 1; borderBottom: {color: "#ff0000"; style: 2}})
VP SET FORMULA(VP Cell($area; 0; 12; 0); "=HYPERLINK(\"https://example.com/fixture\",\"Fixture link\")")
VP ADD SHEET($area; 1; "Hidden candidate")
VP SET TEXT VALUE(VP Cell($area; 0; 0; 1); "Second sheet")
VP ADD SHEET($area; 0; "First")
VP SET TEXT VALUE(VP Cell($area; 0; 0; 0); "Inserted first; Data moved to index 1")
VP SET FORMULA(VP Cell($area; 1; 0; 0); "=Data!B1")
VP ADD SHEET($area; 3; "Very hidden candidate")
VP SET TEXT VALUE(VP Cell($area; 0; 0; 3); "Very hidden sheet")
VP SET CURRENT SHEET($area; 1)
