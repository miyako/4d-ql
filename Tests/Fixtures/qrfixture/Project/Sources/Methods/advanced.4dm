C_LONGINT($area; $i)
C_BLOB($blob)
C_TEXT($out)
Get database parameter(User param value; $out)
$area:=QR New offscreen area
QR SET REPORT TABLE($area; 1)
QR INSERT COLUMN($area; 1; "[Customers]Region")
QR INSERT COLUMN($area; 2; "[Customers]Name")
QR INSERT COLUMN($area; 3; "[Customers]Amount")
QR SET INFO COLUMN($area; 1; "Region"; "[Customers]Region"; 0; 120; 0; "")
QR SET INFO COLUMN($area; 2; "Customer"; "[Customers]Name"; 0; 180; 1; "")
QR SET INFO COLUMN($area; 3; "Amount"; "[Customers]Amount"; 0; 110; 1; "###,##0.00")
QR SET HEADER AND FOOTER($area; 1; "Sales report"; "Quarterly summary"; "2026"; 40)
QR SET HEADER AND FOOTER($area; 2; "Confidential"; ""; "Page #"; 30)
QR SET TEXT PROPERTY($area; 1; -1; 3; 1)
QR SET TEXT PROPERTY($area; 2; -1; 3; 1)
QR SET TEXT PROPERTY($area; 3; -1; 3; 1)
QR SET TEXT PROPERTY($area; 3; -2; 7; 3)
QR SET TEXT PROPERTY($area; 1; -1; 8; 0x00DDEEFF)
QR SET TEXT PROPERTY($area; 2; -1; 8; 0x00DDEEFF)
QR SET TEXT PROPERTY($area; 3; -1; 8; 0x00DDEEFF)
ARRAY REAL($cols; 2)
ARRAY REAL($orders; 2)
$cols{1}:=1
$cols{2}:=3
$orders{1}:=1
$orders{2}:=-1
QR SET SORTS($area; $cols; $orders)
QR SET TOTALS DATA($area; 1; 1; "Subtotal #")
QR SET TOTALS DATA($area; 3; 1; 1)
QR SET TOTALS DATA($area; 1; -3; "Grand total")
QR SET TOTALS DATA($area; 3; -3; 17)
QR SET BORDERS($area; 3; -1; 8; 4; 0x00123456)
QR REPORT TO BLOB($area; $blob)
File($out+"/sales.4qr").setContent($blob)
QR SET DOCUMENT PROPERTY($area; 2; 1)
QR REPORT TO BLOB($area; $blob)
File($out+"/centimeters.4qr").setContent($blob)
QR SET DOCUMENT PROPERTY($area; 2; 2)
QR REPORT TO BLOB($area; $blob)
File($out+"/inches.4qr").setContent($blob)
QR SET REPORT KIND($area; 2)
QR SET INFO COLUMN($area; 1; ""; "[Customers]Region"; 0; 120; 1; "")
QR SET INFO COLUMN($area; 2; ""; "[Customers]Name"; 0; 160; 1; "")
QR SET INFO COLUMN($area; 3; ""; "[Customers]Amount"; 0; 100; 1; "###,##0.00")
QR SET TOTALS DATA($area; 2; 2; 1)
QR SET TOTALS DATA($area; 3; 1; "Row total")
QR SET TOTALS DATA($area; 1; 3; "Column total")
QR REPORT TO BLOB($area; $blob)
File($out+"/crosstab.4qr").setContent($blob)
QR DELETE OFFSCREEN AREA($area)
LOG EVENT(Into system standard outputs; "ADVANCED DONE\n")
QUIT 4D
